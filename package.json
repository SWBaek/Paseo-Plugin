{
  "name": "paseo-plugins-workspace",
  "private": true,
  "version": "0.1.0-rc.4",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "test:scripts": "node --test scripts/check-git-source-imports.test.mjs scripts/release-paseo.test.mjs",
    "check:docs-sync": "node scripts/check-doc-sync.mjs",
    "check:git-source-imports": "node scripts/check-git-source-imports.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:release": "node scripts/check-release.mjs",
    "test": "npm run test:scripts && node scripts/run-tests.mjs",
    "check": "npm run check:docs-sync && npm run check:git-source-imports && npm run check:release && npm run typecheck && npm test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaruForge/Paseo-Plugin.git"
  },
  "bugs": {
    "url": "https://github.com/NaruForge/Paseo-Plugin/issues"
  }
}
